  "runs": [
    {
      "tool": {
        "driver": {
          "name": "tdp",
          "version": "0.0.0",
          "rules": [
            {
              "id": "tdp/critical",
              "name": "CriticalMaintenancePriority",
              "shortDescription": {
                "text": "Critical maintenance priority"
              },
              "fullDescription": {
                "text": "Priority 90 to 100 out of 100, a percentile within the repository: the file is among the most likely to need bug fixes and rework in the next 12 months."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "help": {
                "text": "Priority is a percentile within the repository, computed from code structure, change history, ownership, past bugs, dependencies, tests and admitted debt. The alert message lists the strongest reasons. Before a risky change, consider adding tests or simplifying the code those reasons point to."
              },
              "properties": {
                "tags": [
                  "maintainability",
                  "technical-debt"
                ]
              }
            },
            {
              "id": "tdp/high",
              "name": "HighMaintenancePriority",
              "shortDescription": {
                "text": "High maintenance priority"
              },
              "fullDescription": {
                "text": "Priority 75 to 89 out of 100, a percentile within the repository: the file is more likely than most to need bug fixes and rework in the next 12 months."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "help": {
                "text": "Priority is a percentile within the repository, computed from code structure, change history, ownership, past bugs, dependencies, tests and admitted debt. The alert message lists the strongest reasons. Before a risky change, consider adding tests or simplifying the code those reasons point to."
              },
              "properties": {
                "tags": [
                  "maintainability",
                  "technical-debt"
                ]
              }
            }
          ]
        }
