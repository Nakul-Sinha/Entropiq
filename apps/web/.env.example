# Copy to .env.local for local development.

# 1 answers every API call from the built-in mock data (no backend needed).
NEXT_PUBLIC_USE_MOCKS=1

# API base for server-side calls and for the /api/v1 rewrite. The rewrite is read at build time,
# so set it before `npm run build` as well as at runtime.
API_URL=http://localhost:8000
